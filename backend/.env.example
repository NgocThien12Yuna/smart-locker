# SmartLocker backend - LOCAL + RAILWAY

# BẮT BUỘC
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_REGISTER_CODE=SMARTLOCKER_ADMIN_2026

# OTP
OTP_TTL_MINUTES=15

# LOCAL DEV ONLY:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# RAILWAY / CLOUD:
# Paste nguyên JSON Firebase service account vào Railway Variables.
# KHÔNG commit private key thật vào Git.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional nếu muốn ép path DB.
# Railway có volume thì thường KHÔNG cần set vì code tự đọc
# RAILWAY_VOLUME_MOUNT_PATH.
# DB_PATH=/data/smartlocker.db
